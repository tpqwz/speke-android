<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <ListView
        android:id="@+id/feeds_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/feeds_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/feeds_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/floating_bar_margin"
            android:layout_marginTop="@dimen/floating_bar_margin_top"
            android:layout_marginEnd="@dimen/floating_bar_margin"
            android:layout_marginBottom="@dimen/floating_bar_margin_bottom"
            android:background="@drawable/bg_floating_bar"
            android:elevation="@dimen/floating_toolbar_elevation"
            android:minHeight="@dimen/floating_toolbar_height"
            app:buttonGravity="center_vertical"
            app:maxButtonHeight="@dimen/floating_toolbar_height"
            app:titleTextAppearance="@style/TextAppearance.App.FloatingToolbarTitle" />

        <include
            layout="@layout/view_audio_miniplayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/floating_bar_margin"
            android:layout_marginEnd="@dimen/floating_bar_margin"
            android:layout_marginBottom="@dimen/floating_bar_margin_bottom" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/floating_nav_bar_height"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/floating_bar_margin_horizontal"
        android:layout_marginBottom="@dimen/floating_bar_margin"
        android:background="@drawable/bg_floating_nav"
        android:elevation="@dimen/floating_nav_elevation"
        app:activeIndicatorLabelPadding="@dimen/floating_nav_label_padding"
        app:itemPaddingBottom="@dimen/floating_nav_item_padding_bottom"
        app:itemPaddingTop="@dimen/floating_nav_item_padding_top"
        app:itemTextAppearanceActive="@style/TextAppearance.App.NavigationBarLabel"
        app:itemTextAppearanceInactive="@style/TextAppearance.App.NavigationBarLabel"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu_rss" />

</RelativeLayout>
