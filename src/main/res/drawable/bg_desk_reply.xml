<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@color/desk_accent" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:width="2dp" android:gravity="left|fill_vertical">
                <shape android:shape="rectangle">
                    <solid android:color="@color/desk_hair" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="2dp" android:gravity="left|fill_vertical">
                <shape android:shape="rectangle">
                    <solid android:color="@color/desk_hair" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
